# /etc/systemd/system/nightshift-drain.service
# Runs ONE Night Shift drain in a fresh, isolated container, then exits.
# Type=oneshot => systemd will not start a second run while one is active (no overlap).
[Unit]
Description=ClubHanger Night Shift drain (one cycle batch)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# The drain self-terminates on "night ended" + its own token/time budget, so a
# tight systemd start-timeout is redundant AND harmful: at 4300s (72min) systemd
# SIGTERM'd (status=143) each batch mid-run, producing a stream of red "Failed
# (timeout)" statuses and occasionally killing a cycle mid-work (2026-07-04).
# 30000s (~8.3h) is a generous backstop that outlasts a full night window so a
# normal batch exits cleanly on its own.
TimeoutStartSec=30000
# --memory caps the build spike (measured ~2.3GB for `next build`; ~3GB with Chrome QA).
# If the OOM cap kills builds, raise it / size up the box rather than lowering it.
# ExecStartPre clears a stale same-named container before each run. `--rm` normally
# handles cleanup, but if the daemon restarts mid-exit the container can linger and
# every subsequent `docker run --name` 125-conflicts — silently stalling the loop for
# hours (happened 2026-06-27). The `-` prefix ignores "no such container".
ExecStartPre=-/usr/bin/docker rm -f clubhanger-nightshift
ExecStart=/usr/bin/docker run --rm \
  --name clubhanger-nightshift \
  --memory=4g --memory-swap=5g --cpus=1.5 \
  -e NS_STATE_DIR=/home/night/state \
  -e TZ=America/Los_Angeles \
  -e NS_ESCALATE_MODEL=sonnet \
  -e NS_JUDGE_MODEL=sonnet \
  -v /opt/nightshift/repo:/app \
  -v /opt/nightshift/claude:/home/night/.claude \
  -v /opt/nightshift/state:/home/night/state \
  -v /opt/nightshift/ssh:/home/night/.ssh:ro \
  clubhanger-nightshift:latest

[Install]
WantedBy=multi-user.target
